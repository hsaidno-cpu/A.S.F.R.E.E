{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hsaidno-cpu/A.S.F.R.E.E/blob/main/plugin/references/schemas/governance/ecosystem-identity-registry.schema.json",
  "title": "A.S.F.R.E.E Ecosystem Identity Registry",
  "type": "object",
  "required": [
    "registry_schema_version",
    "registry_id",
    "purpose",
    "products",
    "global_invariants",
    "release_governance_path",
    "migration_policy_path"
  ],
  "properties": {
    "registry_schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "const": "asfree-ecosystem-identities"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "product_id",
          "display_name",
          "canonical_repository",
          "default_branch",
          "plugins",
          "independent_artifacts",
          "migration_policy_path",
          "change_history_source"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "canonical_repository": {
            "type": "string",
            "format": "uri"
          },
          "default_branch": {
            "type": "string",
            "minLength": 1
          },
          "plugins": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "identity_id",
                "plugin_id",
                "plugin_name",
                "role",
                "version_source",
                "version_scope",
                "source_activation_rule",
                "change_history_source"
              ],
              "properties": {
                "identity_id": {
                  "type": "string",
                  "minLength": 1
                },
                "plugin_id": {
                  "type": "string",
                  "pattern": "^(plugins|Plugin)_[A-Za-z0-9]+$"
                },
                "plugin_name": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "CANONICAL",
                    "COMPATIBILITY_REDIRECT",
                    "INDEPENDENT_PLUGIN"
                  ]
                },
                "target_identity_id": {
                  "type": "string"
                },
                "version_source": {
                  "type": "string",
                  "minLength": 1
                },
                "version_scope": {
                  "type": "string",
                  "minLength": 1
                },
                "source_activation_rule": {
                  "type": "string",
                  "minLength": 1
                },
                "change_history_source": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "independent_artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "artifact_id",
                "version_source",
                "version_relation",
                "must_match_canonical_plugin_version"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "version_source": {
                  "type": "string",
                  "minLength": 1
                },
                "version_relation": {
                  "enum": [
                    "MIRROR",
                    "DEPLOYMENT_RECORD",
                    "INDEPENDENT"
                  ]
                },
                "must_match_canonical_plugin_version": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "migration_policy_path": {
            "type": "string",
            "minLength": 1
          },
          "change_history_source": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "global_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "release_governance_path": {
      "type": "string",
      "minLength": 1
    },
    "migration_policy_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
