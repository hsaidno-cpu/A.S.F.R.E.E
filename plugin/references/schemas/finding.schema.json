{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A.S.F.R.E.E Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "target_id",
    "category",
    "title",
    "description",
    "evidence_refs",
    "confidence",
    "severity",
    "status",
    "limitations"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^FND-[A-Z0-9-]+$"
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "POSITIVE",
        "NEGATIVE",
        "DEFECT",
        "RISK",
        "GAP",
        "OBSERVATION",
        "UNKNOWN"
      ]
    },
    "subcategory": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "artifact_locator": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "method_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "method": {
      "type": "string"
    },
    "reproduction_status": {
      "enum": [
        "REPRODUCED",
        "NOT_REPRODUCIBLE",
        "INTERMITTENT",
        "BLOCKED",
        "INCOMPLETE",
        "NOT_APPLICABLE",
        "NOT_TESTED"
      ]
    },
    "confidence": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNASSESSED"
      ]
    },
    "severity": {
      "enum": [
        "P0_CRITICAL",
        "P1_HIGH",
        "P2_MEDIUM",
        "P3_LOW",
        "UNASSESSED"
      ]
    },
    "likelihood": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNKNOWN",
        "NOT_ASSESSED"
      ]
    },
    "impact": {
      "type": "string"
    },
    "root_cause_hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counterevidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "OPEN",
        "CONFIRMED",
        "HYPOTHESIS",
        "DISPUTED",
        "RESOLVED",
        "ACCEPTED_LIMITATION"
      ]
    },
    "epistemic_status": {
      "enum": [
        "DIRECT_OBSERVATION",
        "USER_CLAIM",
        "SOURCE_CLAIM",
        "VERIFIED_SOURCE_CLAIM",
        "ASSUMPTION",
        "INFERENCE",
        "HYPOTHESIS",
        "PREDICTION",
        "NORMATIVE_JUDGMENT",
        "RECOMMENDATION"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
