{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A.S.F.R.E.E Method Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "method_id",
    "name",
    "purpose",
    "inputs",
    "outputs",
    "limitations"
  ],
  "properties": {
    "method_id": {
      "type": "string",
      "pattern": "^MTH-[A-Z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "question_answered": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "procedure": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validity_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selection_rationale": {
      "type": "string"
    },
    "validation_method": {
      "type": "string"
    }
  }
}
