{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asfree.dev/schemas/security/human-security-review.schema.json",
  "title": "A.S.F.R.E.E Independent Human Security Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "reviewer_id",
    "reviewer_role",
    "independent_from_builder",
    "conflict_declaration",
    "review_scope",
    "commit_sha",
    "evidence_ids",
    "findings",
    "residual_risks",
    "decision",
    "reviewed_at",
    "signature"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 12
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_role": {
      "type": "string",
      "minLength": 1
    },
    "independent_from_builder": {
      "const": true
    },
    "conflict_declaration": {
      "enum": [
        "NONE_DECLARED",
        "CONFLICT_DECLARED_WITH_MITIGATION",
        "CONFLICT_UNRESOLVED"
      ]
    },
    "review_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "provider_runtime_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "severity",
          "disposition"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ]
          },
          "disposition": {
            "enum": [
              "FIXED",
              "ACCEPTED_BY_RISK_OWNER",
              "OPEN",
              "NOT_APPLICABLE"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "enum": [
        "APPROVE_STAGING",
        "APPROVE_PRODUCTION",
        "APPROVE_WITH_RESTRICTIONS",
        "REJECT",
        "HOLD"
      ]
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "signature": {
      "type": "object",
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "Ed25519",
            "ES256",
            "PS256"
          ]
        },
        "key_id": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "minLength": 16
        }
      },
      "additionalProperties": false
    }
  }
}
