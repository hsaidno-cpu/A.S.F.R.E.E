{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asfree.dev/schemas/security/delegated-capability.schema.json",
  "title": "A.S.F.R.E.E Delegated Capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "issuer",
    "subject",
    "tenant_id",
    "audience",
    "actions",
    "resource",
    "actor_chain",
    "issued_at",
    "expires_at",
    "jti",
    "kid",
    "signature"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor_chain": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor_id",
          "delegated_at"
        ],
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "delegated_at": {
            "type": "string",
            "format": "date-time"
          },
          "parent_jti": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "jti": {
      "type": "string",
      "minLength": 16
    },
    "kid": {
      "type": "string",
      "minLength": 1
    },
    "scope_attenuation": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "revocation_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
