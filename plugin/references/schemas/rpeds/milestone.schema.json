{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hsaidno-cpu/A.S.F.R.E.E/blob/main/plugin/references/schemas/rpeds/milestone.schema.json",
  "title": "A.S.F.R.E.E RPEDS Milestone",
  "description": "A milestone is accepted only with predeclared criteria, verification evidence, an O12 evaluation disposition, and required approvals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "milestone_id",
    "roadmap_id",
    "phase_id",
    "name",
    "sequence",
    "objective",
    "status",
    "acceptance_criteria",
    "gate_disposition",
    "approval_required",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "milestone_id": {
      "type": "string",
      "pattern": "^ASRMIL-[A-Z0-9][A-Z0-9._-]*$"
    },
    "roadmap_id": {
      "type": "string",
      "pattern": "^ASRMAP-[A-Z0-9][A-Z0-9._-]*$"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^ASRPH-[A-Z0-9][A-Z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNED",
        "IN_PROGRESS",
        "BLOCKED",
        "READY_FOR_REVIEW",
        "ACCEPTED",
        "REJECTED",
        "DEFERRED",
        "CANCELLED"
      ]
    },
    "entry_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency_id",
          "relationship",
          "status"
        ],
        "properties": {
          "dependency_id": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "enum": [
              "DEPENDS_ON",
              "BLOCKS",
              "ENABLES",
              "RELATED_TO"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "DOCUMENTED",
              "OBSERVED",
              "INFERRED",
              "HYPOTHESIS",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "planned_start": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "target_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "accepted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "gate_disposition": {
      "enum": [
        "NOT_RUN",
        "NOT_ASSESSED",
        "PASS",
        "PASS_WITH_CAVEATS",
        "HOLD",
        "FAIL",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "required_test_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "actual_test_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verification_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evaluation_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "blocker_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "gate_rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACCEPTED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "accepted_at",
          "evaluation_ref",
          "verification_refs",
          "evidence_refs"
        ],
        "properties": {
          "gate_disposition": {
            "enum": [
              "PASS",
              "PASS_WITH_CAVEATS"
            ]
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time"
          },
          "evaluation_ref": {
            "type": "string",
            "minLength": 1
          },
          "verification_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACCEPTED"
          },
          "approval_required": {
            "const": true
          }
        },
        "required": [
          "status",
          "approval_required"
        ]
      },
      "then": {
        "properties": {
          "approval_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "approval_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACCEPTED"
          },
          "required_test_refs": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": [
          "status",
          "required_test_refs"
        ]
      },
      "then": {
        "properties": {
          "actual_test_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "actual_test_refs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocker_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "blocker_refs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "gate_disposition": {
            "const": "NOT_APPLICABLE"
          }
        },
        "required": [
          "gate_disposition"
        ]
      },
      "then": {
        "properties": {
          "gate_rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "gate_rationale"
        ]
      }
    }
  ]
}
