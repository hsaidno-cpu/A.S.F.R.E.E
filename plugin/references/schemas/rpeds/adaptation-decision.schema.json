{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A.S.F.R.E.E RPEDS Adaptation Decision",
  "description": "Evidence-backed and approval-aware record of a roadmap adjustment. Prior revisions and rejected alternatives are preserved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "roadmap_id",
    "from_revision",
    "action",
    "trigger",
    "alternatives",
    "rationale",
    "impact_analysis",
    "status",
    "approval_required",
    "approval_refs",
    "verification_refs",
    "residual_risk"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^RPD-[A-Z0-9][A-Z0-9._-]*$"
    },
    "roadmap_id": {
      "type": "string",
      "pattern": "^RPDS-[A-Z0-9][A-Z0-9._-]*$"
    },
    "from_revision": {
      "type": "integer",
      "minimum": 1
    },
    "to_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "action": {
      "enum": [
        "CONTINUE",
        "RESEQUENCE",
        "REBASELINE",
        "SPLIT",
        "MERGE",
        "DEFER",
        "PILOT",
        "ROLLBACK",
        "STOP",
        "CLOSE"
      ]
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "description",
        "evidence_refs"
      ],
      "properties": {
        "category": {
          "enum": [
            "GATE_FAILURE",
            "SCOPE_DRIFT",
            "DEPENDENCY_DRIFT",
            "RESOURCE_CONSTRAINT",
            "RISK_CHANGE",
            "OUTCOME_VARIANCE",
            "NEW_OPPORTUNITY",
            "EXTERNAL_CHANGE",
            "OTHER"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "confidence": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNASSESSED"
          ]
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "trade_offs"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "trade_offs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selected": {
            "type": "boolean"
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "impact_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "dependencies",
        "risk",
        "stakeholders"
      ],
      "properties": {
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schedule": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compatibility": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stakeholders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "PROPOSED",
        "NEEDS_APPROVAL",
        "APPROVED",
        "REJECTED",
        "IMPLEMENTING",
        "IMPLEMENTED",
        "VERIFICATION_PENDING",
        "VERIFIED",
        "SUPERSEDED"
      ]
    },
    "decision_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "o11_authorization_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "o12_evaluation_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "implementation_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "residual_risk": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "review_trigger": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
