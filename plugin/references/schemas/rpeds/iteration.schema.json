{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hsaidno-cpu/A.S.F.R.E.E/blob/main/plugin/references/schemas/rpeds/iteration.schema.json",
  "title": "A.S.F.R.E.E RPEDS Development Iteration",
  "description": "A bounded development cycle with a declared baseline, committed work scope, exit criteria, actual outcomes and review evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "iteration_id",
    "roadmap_id",
    "sequence",
    "title",
    "objective",
    "status",
    "baseline_ref",
    "baseline_evidence_refs",
    "committed_work_item_refs",
    "exit_criteria",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "iteration_id": {
      "type": "string",
      "pattern": "^ASRITR-[A-Z0-9][A-Z0-9._-]*$"
    },
    "roadmap_id": {
      "type": "string",
      "pattern": "^ASRMAP-[A-Z0-9][A-Z0-9._-]*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNED",
        "READY",
        "IN_PROGRESS",
        "BLOCKED",
        "REVIEW",
        "ACCEPTED",
        "ABANDONED"
      ]
    },
    "baseline_ref": {
      "type": "string",
      "minLength": 1
    },
    "baseline_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "committed_work_item_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ASRWRK-[A-Z0-9][A-Z0-9._-]*$"
      },
      "uniqueItems": true
    },
    "milestone_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ASRMIL-[A-Z0-9][A-Z0-9._-]*$"
      },
      "uniqueItems": true
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency_id",
          "relationship",
          "status"
        ],
        "properties": {
          "dependency_id": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "enum": [
              "DEPENDS_ON",
              "BLOCKS",
              "ENABLES",
              "RELATED_TO"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "DOCUMENTED",
              "OBSERVED",
              "INFERRED",
              "HYPOTHESIS",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "exit_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "start_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "end_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "actual_outcomes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evaluation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "retrospective": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "accepted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "disposition_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACCEPTED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "actual_outcomes",
          "evidence_refs",
          "evaluation_refs",
          "retrospective",
          "accepted_at"
        ],
        "properties": {
          "actual_outcomes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evaluation_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "retrospective": {
            "type": "string",
            "minLength": 1
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ABANDONED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "disposition_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "disposition_reason"
        ]
      }
    }
  ]
}
