{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A.S.F.R.E.E RPEDS Development Iteration",
  "description": "Bounded development cycle with declared baseline, committed scope, exit criteria and observed outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "iteration_id",
    "roadmap_id",
    "sequence",
    "title",
    "objective",
    "status",
    "baseline_ref",
    "committed_work_item_refs",
    "exit_criteria",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "iteration_id": {
      "type": "string",
      "pattern": "^RPI-[A-Z0-9][A-Z0-9._-]*$"
    },
    "roadmap_id": {
      "type": "string",
      "pattern": "^RPDS-[A-Z0-9][A-Z0-9._-]*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PLANNED",
        "READY",
        "IN_PROGRESS",
        "BLOCKED",
        "REVIEW",
        "ACCEPTED",
        "ABANDONED"
      ]
    },
    "baseline_ref": {
      "type": "string",
      "minLength": 1
    },
    "committed_work_item_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "milestone_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency_id",
          "relationship",
          "status"
        ],
        "properties": {
          "dependency_id": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "enum": [
              "DEPENDS_ON",
              "BLOCKS",
              "ENABLES",
              "RELATED_TO"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "DOCUMENTED",
              "OBSERVED",
              "INFERRED",
              "HYPOTHESIS",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "exit_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "start_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "end_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "actual_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evaluation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "retrospective": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
