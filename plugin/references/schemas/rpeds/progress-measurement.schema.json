{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A.S.F.R.E.E RPEDS Progress Measurement",
  "description": "One evidence-backed progress or outcome observation. Different measures remain separate unless normalization and weights are approved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "measurement_id",
    "roadmap_id",
    "subject_type",
    "subject_id",
    "indicator_id",
    "definition",
    "measurement_type",
    "method",
    "unit_or_rubric",
    "direction",
    "status",
    "evidence_refs",
    "confidence",
    "uncertainty",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "measurement_id": {
      "type": "string",
      "pattern": "^RPV-[A-Z0-9][A-Z0-9._-]*$"
    },
    "roadmap_id": {
      "type": "string",
      "pattern": "^RPDS-[A-Z0-9][A-Z0-9._-]*$"
    },
    "subject_type": {
      "enum": [
        "ROADMAP",
        "PHASE",
        "MILESTONE",
        "ITERATION",
        "WORK_ITEM",
        "SYSTEM_OUTCOME"
      ]
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "indicator_id": {
      "type": "string",
      "minLength": 1
    },
    "dimension": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "measurement_type": {
      "enum": [
        "QUANTITATIVE",
        "QUALITATIVE",
        "MIXED"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "unit_or_rubric": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "HIGHER_IS_BETTER",
        "LOWER_IS_BETTER",
        "TARGET_RANGE",
        "DESCRIPTIVE",
        "BINARY_GATE"
      ]
    },
    "baseline": {
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },
    "target": {
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },
    "observed_value": {
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },
    "threshold": {
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },
    "status": {
      "enum": [
        "OBSERVED",
        "NOT_ASSESSED",
        "INSUFFICIENT_EVIDENCE",
        "STALE",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "confidence": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNASSESSED"
      ]
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weight": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "weight_approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "o12_evaluation_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
