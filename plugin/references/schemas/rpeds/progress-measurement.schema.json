{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hsaidno-cpu/A.S.F.R.E.E/blob/main/plugin/references/schemas/rpeds/progress-measurement.schema.json",
  "title": "A.S.F.R.E.E RPEDS Progress Measurement",
  "description": "One evidence-backed progress or outcome observation. Observed values and weighted values require evidence and explicit validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "measurement_id",
    "roadmap_id",
    "subject_type",
    "subject_id",
    "indicator_id",
    "definition",
    "measurement_type",
    "method",
    "unit_or_rubric",
    "direction",
    "status",
    "evidence_refs",
    "confidence",
    "uncertainty",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "measurement_id": {
      "type": "string",
      "pattern": "^ASREVL-[A-Z0-9][A-Z0-9._-]*$"
    },
    "roadmap_id": {
      "type": "string",
      "pattern": "^ASRMAP-[A-Z0-9][A-Z0-9._-]*$"
    },
    "subject_type": {
      "enum": [
        "ROADMAP",
        "PHASE",
        "MILESTONE",
        "ITERATION",
        "WORK_ITEM",
        "SYSTEM_OUTCOME"
      ]
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "indicator_id": {
      "type": "string",
      "minLength": 1
    },
    "dimension": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "measurement_type": {
      "enum": [
        "QUANTITATIVE",
        "QUALITATIVE",
        "MIXED"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "unit_or_rubric": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "HIGHER_IS_BETTER",
        "LOWER_IS_BETTER",
        "TARGET_RANGE",
        "DESCRIPTIVE",
        "BINARY_GATE"
      ]
    },
    "baseline": {
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },
    "target": {
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },
    "observed_value": {
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },
    "threshold": {
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },
    "status": {
      "enum": [
        "OBSERVED",
        "NOT_ASSESSED",
        "INSUFFICIENT_EVIDENCE",
        "STALE",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "confidence": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNASSESSED"
      ]
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "weight": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "weight_approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "o12_evaluation_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "OBSERVED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "observed_value",
          "source_version",
          "observed_at",
          "evidence_refs"
        ],
        "properties": {
          "observed_value": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "NOT_ASSESSED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "limitations"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "weight": {
            "type": "number"
          }
        },
        "required": [
          "weight"
        ]
      },
      "then": {
        "properties": {
          "weight_approval_ref": {
            "type": "string",
            "minLength": 1
          },
          "o12_evaluation_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "weight_approval_ref",
          "o12_evaluation_ref"
        ]
      }
    }
  ]
}
