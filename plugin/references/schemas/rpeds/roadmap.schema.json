{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hsaidno-cpu/A.S.F.R.E.E/blob/main/plugin/references/schemas/rpeds/roadmap.schema.json",
  "title": "A.S.F.R.E.E RPEDS Roadmap",
  "description": "Versioned roadmap contract. Lifecycle states that assert approval or closure carry their own approval/closure evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "roadmap_id",
    "title",
    "status",
    "target",
    "objective",
    "scope",
    "baseline",
    "target_state",
    "phases",
    "progress_policy",
    "governance",
    "revision",
    "source_refs",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "roadmap_id": {
      "type": "string",
      "pattern": "^ASRMAP-[A-Z0-9][A-Z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "APPROVED",
        "ACTIVE",
        "ON_HOLD",
        "COMPLETED",
        "CANCELLED",
        "SUPERSEDED"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "target_type",
        "name"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "target_type": {
          "enum": [
            "PLUGIN",
            "SKILL",
            "ORCHESTRATOR",
            "REPOSITORY",
            "APPLICATION",
            "SERVICE",
            "API",
            "MCP_SERVER",
            "DATA_SYSTEM",
            "PROGRAM",
            "OTHER"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version_or_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "out_of_scope"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "captured_at",
        "evidence_refs",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "PARTIAL",
            "UNKNOWN",
            "NOT_ASSESSED"
          ]
        },
        "version_or_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "target_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "success_conditions"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "version_or_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase_id",
          "name",
          "sequence",
          "objective",
          "entry_criteria",
          "exit_criteria"
        ],
        "properties": {
          "phase_id": {
            "type": "string",
            "pattern": "^ASRPH-[A-Z0-9][A-Z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "entry_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exit_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "milestone_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dependency_id",
                "relationship",
                "status"
              ],
              "properties": {
                "dependency_id": {
                  "type": "string",
                  "minLength": 1
                },
                "relationship": {
                  "enum": [
                    "DEPENDS_ON",
                    "BLOCKS",
                    "ENABLES",
                    "RELATED_TO"
                  ]
                },
                "evidence_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "DOCUMENTED",
                    "OBSERVED",
                    "INFERRED",
                    "HYPOTHESIS",
                    "UNKNOWN"
                  ]
                }
              }
            }
          },
          "gate_owner": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency_id",
          "relationship",
          "status"
        ],
        "properties": {
          "dependency_id": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "enum": [
              "DEPENDS_ON",
              "BLOCKS",
              "ENABLES",
              "RELATED_TO"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "DOCUMENTED",
              "OBSERVED",
              "INFERRED",
              "HYPOTHESIS",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "progress_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "weights_approved"
      ],
      "properties": {
        "method": {
          "enum": [
            "VERIFIED_WORK_ITEM_RATIO",
            "MILESTONE_ACCEPTANCE_RATIO",
            "INDICATOR_DASHBOARD",
            "APPROVED_WEIGHTED_COMPOSITE"
          ]
        },
        "weights_approved": {
          "type": "boolean"
        },
        "weight_rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "o12_validation_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_owner",
        "approval_required",
        "approval_state"
      ],
      "properties": {
        "decision_owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_required": {
          "type": "boolean"
        },
        "approval_state": {
          "enum": [
            "NOT_REQUIRED",
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "approval_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "authority_level": {
          "enum": [
            "S0",
            "S1",
            "S2",
            "S3",
            "S4",
            "S5"
          ]
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closed_at",
        "closure_evidence_refs",
        "residual_risk_disposition"
      ],
      "properties": {
        "closed_at": {
          "type": "string",
          "format": "date-time"
        },
        "closure_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "residual_risk_disposition": {
          "enum": [
            "RESOLVED",
            "ACCEPTED",
            "TRANSFERRED",
            "OPEN_WITH_OWNER"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_replanned_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "APPROVED",
              "ACTIVE",
              "COMPLETED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "governance": {
            "required": [
              "decision_owner",
              "approval_state",
              "approved_by",
              "approved_at",
              "approval_evidence_refs"
            ],
            "properties": {
              "decision_owner": {
                "type": "string",
                "minLength": 1
              },
              "approval_state": {
                "const": "APPROVED"
              },
              "approved_by": {
                "type": "string",
                "minLength": 1
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              },
              "approval_evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "closure"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUPERSEDED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "supersedes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "progress_policy": {
            "properties": {
              "method": {
                "const": "APPROVED_WEIGHTED_COMPOSITE"
              }
            },
            "required": [
              "method"
            ]
          }
        },
        "required": [
          "progress_policy"
        ]
      },
      "then": {
        "properties": {
          "progress_policy": {
            "required": [
              "weights_approved",
              "weight_rationale",
              "approved_by",
              "o12_validation_ref"
            ],
            "properties": {
              "weights_approved": {
                "const": true
              },
              "weight_rationale": {
                "type": "string",
                "minLength": 1
              },
              "approved_by": {
                "type": "string",
                "minLength": 1
              },
              "o12_validation_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
